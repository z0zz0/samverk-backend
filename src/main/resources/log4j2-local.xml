<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss} %-5level - %msg{nolookups}%n</Property>
        <Property name="SEQ_URL">http://localhost:5341</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
        <Socket name="SeqAppender" host="localhost" port="5341" protocol="TCP">
            <JsonLayout properties="true" eventEol="true" compact="true"/>
        </Socket>
    </Appenders>
    <Loggers>
        <Logger name="org.hibernate" level="ERROR" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="com.samverk" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SeqAppender"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SeqAppender"/>
        </Root>
    </Loggers>
</Configuration>
